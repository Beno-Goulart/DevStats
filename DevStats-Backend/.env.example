# Discord
discord.bot.token=YOUR_DISCORD_BOT_TOKEN
discord.access.token=YOUR_DISCORD_ACCESS_TOKEN
discord.application.id=YOUR_DISCORD_APPLICATION_ID
discord.user.id=YOUR_DISCORD_USER_ID
discord.client.secret=YOUR_DISCORD_CLIENT_SECRET

# Github
github.username=YOUR_GITHUB_USERNAME
github.token=YOUR_GITHUB_TOKEN
github.webhook.secret=YOUR_GITHUB_WEBHOOK_SECRET

# Widget
widget.refresh.minutes=1
